# Neon connection string, pooled. Vercel sets this per environment; locally, copy
# it from the Neon console into .env.local.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# The temporary gate. One user, one passphrase — deleted when Google sign-in
# arrives in iteration 4.
ARVEN_PASSPHRASE="choose-something-long"

# Signs the session cookie. Any long random string; changing it signs everyone out.
#   openssl rand -hex 32
ARVEN_SESSION_SECRET="generate-me"
